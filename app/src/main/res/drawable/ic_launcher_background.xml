<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Feedback round, item 1 (icon dark-render redesign): SOLID
         bright lime field, full bleed — no gradient vector. The
         customization round's gradient background verified intact
         in the built APK, yet Garrett's Fold8 recents pane rendered
         the icon as a black house on a black background: the device
         path blackened the background layer (consistent with system
         dark-icon treatment — One UI 8.5 forced dark icons /
         Android 16 QPR2 auto-theming) while the foreground rendered
         intact. A solid field removes the gradient-vector variable
         from that equation; the foreground below is now ALSO
         self-sufficient (bright off-white tile carrying the mark),
         so the icon stays legible even when a device path forces
         the background to black. Tokens: capsule lime #9BF67C. -->
    <path
        android:fillColor="#9BF67C"
        android:pathData="M0,0 H108 V108 H0 Z" />
</vector>
