<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight parent, not Light: the window background must follow the
         system theme. The old Light parent left a white window behind every
         screen that paints no background of its own — in dark mode the
         login screen showed light scheme text on that white window
         (unreadable) and dark-mode status icons against white, then
         "bounced" to dark once the Scaffold painted after sign-in. -->
    <style name="Theme.Haven" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- NOTE: no windowLightStatusBar here on purpose. The icon color is
             driven dynamically from the background luminance in Compose
             (StatusBarAppearance in HavenApp, Koda's approach): a hardcoded
             value is wrong in one theme or the other, and with the transparent
             bar it made dark-theme icons invisible. -->
    </style>
</resources>
