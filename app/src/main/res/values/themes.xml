<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light parent kept deliberately: Theme.Material3.DayNight.NoActionBar
         does not link in this material3 version (AAPT "not found" broke run
         #42). The dark-mode login fix does NOT depend on the window theme:
         LoginScreen and the OAuth container paint the scheme background
         themselves, so the visible background always matches the scheme
         text. The window background only shows pre-first-frame. -->
    <style name="Theme.Haven" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- NOTE: no windowLightStatusBar here on purpose. The icon color is
             driven dynamically from the background luminance in Compose
             (StatusBarAppearance in HavenApp, Koda's approach): a hardcoded
             value is wrong in one theme or the other, and with the transparent
             bar it made dark-theme icons invisible. -->
    </style>
</resources>
